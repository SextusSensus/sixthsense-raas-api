# RAAS API config. Copy to .env for local runs (uvicorn --env-file .env); on Render set these as env vars.
# Secrets: generate each with  python -c "import secrets;print(secrets.token_hex(32))"
# The server refuses to start without a valid TREASURY_ADDRESS, SESSION_SECRET and VAULT_MASTER_KEY.

DATA_DIR=./data                       # SQLite db + encrypted vault; /var/data on Render (persistent disk)
TREASURY_ADDRESS=                     # Solana public key that receives USDC (its USDC ATA must already exist)
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v   # mainnet USDC; 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU for devnet
PRICE_USDC_PER_HOUR=25                # decimal USDC per hour
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # use a keyed RPC (Helius etc.) in production; treat as secret
ADMIN_WALLETS=                        # comma-separated Solana pubkeys that get the admin console when signed in
ADMIN_TOKEN=                          # bearer token for admin API clients (peaq_events.py); token_hex(32)
ROBOT_TOKEN=                          # bearer token for the robot agent on the K1; token_hex(32)
SESSION_SECRET=                       # HMAC key for session cookies and signed links, >=32 chars; token_hex(32)
VAULT_MASTER_KEY=                     # wraps per-booking file keys, exactly 64 hex chars; token_hex(32). Losing it = all files gone.
MAX_UPLOAD_MB=2048                    # per booking: renter inputs and robot results each get this budget
RESULTS_TTL_HOURS=72                  # results are crypto-shredded this long after a session completes
OPERATOR_TZ=America/New_York          # the weekly availability grid is in this timezone
SESSION_TYPES=operator-run,remote-view   # offered subset of operator-run,remote-view,teleop
SITE_DOMAIN=sixthsense-raas.higgsfield.app       # shown in the Phantom sign-in message
SITE_ORIGIN=https://sixthsense-raas.higgsfield.app   # the booking site; the only origin allowed on /direct/* CORS
PUBLIC_API_URL=https://raas-api.sixthsenselabs.xyz   # this server's own public URL, used in signed direct-transfer links
SECURE_COOKIE=1                       # Secure session cookie unless set to exactly 0 (plain-http local runs only)
